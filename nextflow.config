manifest {
    name = 'crukci-bioinformatics/nf-referencebuilder'
    contributors = [ [ name: 'Richard Bowers' ] ]
    homePage = 'https://github.com/crukci-bioinformatics/nf-referencebuilder'
    description = 'CRUK-CI reference building pipeline. For internal use only.'
    mainScript = 'builder.nf'
    nextflowVersion = '>=26.04.0'
    version = '3.0.0'
}

process.container = 'crukcibioinformatics/referencebuilder:3.0.0'

plugins {
    id 'nf-crukci-support@1.1.3'
}

executor {
    queueSize = 200
    pollInterval = '30sec'
}

singularity.enabled = true
singularity.autoMounts = true
singularity.runOptions = "-B '${projectDir}'"

process {
    errorStrategy = {
        task.exitStatus in [ 104, 134, 137..140, 255 ].flatten() ? 'retry' : 'ignore'
    }

    cpus = 1
    memory = '1GB'
    time = '1h'

    tag = { "${genomeInfo.base}" }

    withLabel:picard {
        memory = { 2.GB * 2 ** (task.attempt - 1) } // So 2, 4, 8, 16 etc
        time = { 8.h * task.attempt }
        maxRetries = 3
    }

    withLabel:builder {
        memory = { 8.GB * 2 ** (task.attempt - 1) } // So 8, 16, 32
        time = { 12.h * task.attempt }
        maxRetries = 2
    }

    withLabel:assembler {
        memory = { 2.GB * 2 ** (task.attempt - 1) } // So 2, 4, 8, 16
        time = { 8.h * task.attempt }
        maxRetries = 3
    }

    withLabel:STAR {
        memory = { 45.GB * 2 ** (task.attempt - 1) } // So 45, 90, 180
        time = { 12.h * task.attempt }
        maxRetries = 2
        cpus = 8
    }

    withLabel:fetcher {
        memory = 4.MB
        time = '1h'
        executor = 'local'
    }

    withLabel:tiny {
        memory = 4.MB
        time = '5m'
        executor = 'local'
    }

    withName:salmonIndex {
        container = { "crukcibioinformatics/salmon:${params.SALMON_VERSION}" }
        tag = { "${genomeInfo.base} k${kmer}" }
    }

    withName:jellyfishCount {
        cpus = 4
        time = { 6.h * task.attempt }
        memory = { 64.GB * task.attempt }
        maxRetries = 3
    }
}

params {

    // Location of properties files.

    genomeInfoDirectory = "${projectDir}/genomeinfo"

    // Software versions.

    BOWTIE2_VERSION = '2.5.5'
    BWA_VERSION = '0.7.19'
    BWAMEM2_VERSION = '2.3'
    SALMON_VERSION = '2.3.4'
    STAR_VERSION = '2.7.11b'

    // Application paths in the container.

    PICARD = "/usr/local/lib/picard.jar"
    REFBUILDER = "/usr/local/lib/nf-referencebuilder.jar"

    // wget additional options

    wgetOptions = '--no-check-certificate'
}

profiles {
    standard {
        params.referenceTop = "/data/personal/bowers01/newreferences"

        process.executor = 'local'
        executor.cpus = 6
        executor.memory = 20.GB
    }

    epyc {
        params.referenceTop = "/mnt/scratche/slow/reference/reference_data/reference_genomes_2025"
        process.executor = 'slurm'
        process.queue = 'epyc'
        process.clusterOptions = "--nodes=1 --open-mode=truncate"
        process.jobName = { "'ReferenceBuilder ${task.process.split(/:/).last()} ${task.tag}'" }
        executor.cpus = 4
        executor.memory = 8.GB
    }

    bioinf {
        params.referenceTop = "/data/reference_data/reference_genomes_2025"

        process.executor = 'local'
        executor.cpus = 28
        executor.memory = 180.GB
    }
}

timeline {
    enabled = true
    file = "${launchDir}/work/execution_timeline.html"
    overwrite = true
}
report {
    enabled = true
    file = "${launchDir}/work/execution_report.html"
    overwrite = true
}
